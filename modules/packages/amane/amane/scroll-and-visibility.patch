+    }
+
+    /// Aim at a new target from wherever the motion currently is, so a new
+    /// wheel notch continues smoothly instead of restarting.
+    fn aim(&mut self, target: f32) {
+        self.from = self.now();
+        self.started = Instant::now();
+        self.target = target.clamp(0.0, self.maximum);
+    }
+
+    /// Jump straight to a value (scrollbar dragging follows the pointer).
+    fn jump(&mut self, value: f32) {
+        self.target = value.clamp(0.0, self.maximum);
+        self.from = self.target;
+        self.started = Instant::now();
+    }
