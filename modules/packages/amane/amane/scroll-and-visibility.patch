+/// Ease rate in 1/s. The remaining distance shrinks by e^-RATE each second,
+/// roughly 70 ms per e-fold, which reads as smooth rather than laggy.
+const RATE: f32 = 14.0;
+/// Below this distance (px) the motion snaps to its target and stops asking
+/// for frames.
+const SETTLED: f32 = 0.25;
