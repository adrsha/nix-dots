+const WALL_VIEW_H: f32 = WALL_HERO_H + 39.0;
+
+/// Range of gallery rows worth building for a scroll offset: the viewport plus
+/// a margin of two rows each way so fast scrolling never shows a spacer.
+fn wall_visible_rows(count: usize, offset: f32) -> (usize, usize) {
+    let pitch = WALL_ROW_H + WALL_ROW_GAP;
+    let margin = 2.0 * pitch;
+    let first = ((offset - margin).max(0.0) / pitch).floor() as usize;
+    let last = (((offset + WALL_VIEW_H + margin) / pitch).ceil() as usize).min(count);
+    (first.min(count), last.max(first.min(count)))
+}
+
+/// Height of a run of `rows` skipped rows, including the gap that the
+/// surrounding column adds next to the spacer.
+fn wall_spacer_height(rows: usize) -> f32 {
+    (rows as f32 * (WALL_ROW_H + WALL_ROW_GAP) - WALL_ROW_GAP).max(0.0)
+}
