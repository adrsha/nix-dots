+        Self {
+            target: value,
+            maximum,
+            from: value,
+            started: Instant::now(),
+        }
+    }
+
+    /// Offset `elapsed` after the motion began, always within the content.
+    fn sample(&self, elapsed: Duration) -> f32 {
+        let remaining = (self.from - self.target) * (-RATE * elapsed.as_secs_f32()).exp();
+        let value = if remaining.abs() < SETTLED {
+            self.target
+        } else {
+            self.target + remaining
+        };
+        value.clamp(0.0, self.maximum)
+    }
+
+    fn moving(&self) -> bool {
+        self.sample(self.started.elapsed()) != self.target
+    }
+
+    fn now(&self) -> f32 {
