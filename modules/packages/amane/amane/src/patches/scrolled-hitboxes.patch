+        target.inverse=Transform::from_translate(0.0, -500.0).invert().unwrap();
+        clip(std::slice::from_mut(&mut target),Area::new(0.0,0.0,400.0,300.0));
+        assert!(target.contains(40.0,120.0));
+        assert!(!target.contains(40.0,310.0));
+    }
