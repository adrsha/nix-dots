--- a/src/input/target.rs
+++ b/src/input/target.rs
@@ -72 +72,34 @@
-        target.area = target.area.intersect(area);
+        // Target areas stay in their own local coordinate space. Map the
+        // clipping viewport there too; intersecting parent coordinates here
+        // discarded translated (scrolled) controls that are visibly onscreen.
+        let corners = [
+            target.inverse.map(area.x, area.y),
+            target.inverse.map(area.x + area.width, area.y),
+            target.inverse.map(area.x, area.y + area.height),
+            target.inverse.map(area.x + area.width, area.y + area.height),
+        ];
+        let left = corners.iter().map(|p| p.0).fold(f32::INFINITY, f32::min);
+        let right = corners.iter().map(|p| p.0).fold(f32::NEG_INFINITY, f32::max);
+        let top = corners.iter().map(|p| p.1).fold(f32::INFINITY, f32::min);
+        let bottom = corners.iter().map(|p| p.1).fold(f32::NEG_INFINITY, f32::max);
+        target.area = target.area.intersect(Area::new(left, top, right-left, bottom-top));
+    }
+}
