# kitty.nix
#
# NixOS module that installs the kitty terminal and gives every normal user a
# declarative kitty.conf.
#
# How it works:
#   1. `kittyConfig` builds the config as a file in the Nix store.
#   2. systemd-tmpfiles symlinks it to ~/.config/kitty/kitty.conf for each user.
#
# To change a setting: edit the text below, then run `nixos-rebuild switch`.
# Restart kitty (or press ctrl+shift+f5 inside it) to pick up the change.
#
# Colors are NOT set here. They come from ~/.config/kitty/themes/active.conf,
# a file generated by theme_manager and pulled in by the `include` line below.
{ inputs, ... }:
{
	flake.nixosModules.kitty = { config, lib, pkgs, ... }:
	let
		kittyConfig = pkgs.writeText "kitty.conf" ''
			# ---------------------------------------------------------------
			# Exit behaviour
			# ---------------------------------------------------------------
			# 0 = never ask for confirmation when closing a window, a tab, or
			# quitting kitty, even if a program is still running inside it.
			confirm_os_window_close 0

			# ---------------------------------------------------------------
			# Fonts
			# ---------------------------------------------------------------
			# The font must be installed by fonts.nix. Check that kitty can see
			# it with: kitty +list-fonts | grep -i dank
			font_family      Dank Mono
			# "auto" picks the bold/italic faces from the same family. This is
			# what gives Dank Mono its cursive italics.
			bold_font        auto
			italic_font      auto
			bold_italic_font auto
			font_size        12.0

			# Ligatures are on by default. "never" means they are never broken
			# up, even under the cursor ("cursor" would split the one being
			# edited, "always" would turn them off everywhere).
			disable_ligatures never

			# Icons (Nerd Font glyphs) that Dank Mono lacks are taken from the
			# fallback fonts in fonts.nix, so no symbol_map is needed.
			#
			# To toggle OpenType features per font, find the PostScript name
			# with `kitty +list-fonts --psnames`, then add for example:
			#   font_features DankMono-Regular +ss01

			# ---------------------------------------------------------------
			# Misc
			# ---------------------------------------------------------------
			scrollback_lines 5000

			# ---------------------------------------------------------------
			# Colors
			# ---------------------------------------------------------------
			# Written by theme_manager (theme-daemon) on every theme switch.
			# Relative to ~/.config/kitty. If the file does not exist yet,
			# kitty just ignores the line. Keep this LAST so the theme wins
			# over anything above. New windows pick up a change straight away;
			# open ones need ctrl+shift+f5 (reload config).
			include themes/active.conf
            dynamic_background_opacity yes
		'';
		users = lib.filter (u: u.isNormalUser) (lib.attrValues config.users.users);
	in
	{
		environment.systemPackages = [ pkgs.kitty ];

		# For each normal user: make sure the directories exist, then link the
		# config. "L+" replaces any existing file or link at that path.
		systemd.tmpfiles.rules = lib.concatMap (u: [
			"d ${u.home}/.config/ - ${u.name} ${u.group} -"
			"d ${u.home}/.config/kitty - ${u.name} ${u.group} -"
			"L+ ${u.home}/.config/kitty/kitty.conf - - - - ${kittyConfig}"
		]) users;

		systemd.user.services.systemd-tmpfiles-setup.restartTriggers = [ kittyConfig ];
	};
}
